#!/bin/sh
# Copyright (C) 2026 dekajoule
# SPDX-License-Identifier: GPL-2.0-or-later
# Collects what an MHO900 test build saw on this unit into one text file for its GitHub issue (docs/mho.md,
# "Reporting back"): the build, the start's report, the screen's log, the fan and the temperatures, the lines of the
# generator, counter, logic analyser and roll. It reads only; it changes nothing on the board. Lines that hold a MAC
# address, a network address or the word "serial" are left out, so the file can be posted as it is.
#
#   oos-mho-report    writes /oos/mho-report-<date>.txt, copies it to a USB stick in the front port if one is
#                     mounted (/mnt/usb), and prints the file's name
OUT=/oos/mho-report-$(date +%Y%m%d-%H%M%S).txt

section() { printf '\n== %s\n' "$1"; }

collect() {
	echo "oos-mho-report $(date -u +%Y-%m-%dT%H:%M:%SZ)"
	section build
	cat /etc/oos-build 2>/dev/null
	uname -r
	uptime
	section "files in /oos"
	(cd /oos && ls -l mho-* bin 2>/dev/null)
	section "fan and temperatures"
	for z in /sys/class/thermal/thermal_zone*; do
		echo "$(basename "$z") $(cat "$z/type" 2>/dev/null) $(cat "$z/temp" 2>/dev/null) $(cat "$z/policy" 2>/dev/null)"
	done
	for c in /sys/class/thermal/cooling_device*; do
		echo "$(basename "$c") $(cat "$c/type" 2>/dev/null) $(cat "$c/cur_state" 2>/dev/null)/$(cat "$c/max_state" 2>/dev/null)"
	done
	for h in /sys/class/hwmon/hwmon*; do
		[ -r "$h/pwm1" ] && echo "$(basename "$h") $(cat "$h/name" 2>/dev/null) pwm1 $(cat "$h/pwm1")"
	done
	section "generator board line"
	ls -l /dev/ttyS4 2>&1
	section "start (oos-fpgad mho-start)"
	tail -n 150 /oos/mho-start.txt 2>/dev/null
	section "oos-mho-live"
	tail -n 100 /tmp/oos-mho-live.log 2>/dev/null
	section "generator, counter, logic analyser, roll, depth, peak, 50 ohm"
	grep -E 'oos-ui mho: (generator|counter|logic|depth|peak|CH[1-4]: 50)|, roll' /tmp/oos-ui.log 2>/dev/null | tail -n 200
	section "screen log (oos-ui), last 600 lines"
	tail -n 600 /tmp/oos-ui.log 2>/dev/null
}

collect 2>&1 | grep -v -i -E '([0-9a-f]{2}:){5}[0-9a-f]{2}|[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|serial' > "$OUT"
if grep -q ' /mnt/usb ' /proc/mounts 2>/dev/null; then
	cp "$OUT" /mnt/usb/ && sync && echo "oos-mho-report: copied to the USB stick"
fi
echo "$OUT"
